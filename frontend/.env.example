# Backend API URL
# - Dev: leave empty (Vite proxy handles it)
# - Production: your backend URL, e.g. https://upisense-backend-xxx.vercel.app
VITE_API_URL=

# For real-time dashboard updates (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Phone OTP (get from Firebase Console → Project settings → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
